# dtxWiki local development stack (docker-compose.yml in this folder).
# Copy to `.env`. These are safe localhost-only defaults — you normally don't
# need to change anything. NOT for production (see infra/prod/).

# ---- Database (PostgreSQL container) ----
POSTGRES_DB=dtxwiki
POSTGRES_USER=dtxwiki
POSTGRES_PASSWORD=dtxwiki
DTXWIKI_POSTGRES_HOST_PORT=21432
DTXWIKI_DATABASE_URL=postgresql+pg8000://dtxwiki:dtxwiki@localhost:21432/dtxwiki

# ---- Local dev auth ----
# Shortcut token that logs you in without OAuth. Dev only — rejected in production.
DTXWIKI_DEV_TOKEN=dev-local

# ---- Ports (host side; change only if one is already taken) ----
DTXWIKI_BACKEND_PORT=21080
DTXWIKI_FRONTEND_DEV_PORT=21173

# ---- CORS (optional) ----
# Defaults to the local backend/frontend ports above. Override only if needed
# (comma-separated or JSON list):
# DTXWIKI_CORS_ORIGINS=http://127.0.0.1:21080,http://localhost:21080,http://127.0.0.1:21173,http://localhost:21173
