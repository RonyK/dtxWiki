# infra/prod/nginx.conf.example
# nginx + certbot reverse proxy for dtxWiki. The Caddy templates are the
# recommended path (Caddy obtains and renews certificates by itself); use this
# when nginx already serves the host. Replace wiki.example.com everywhere, and
# put the file where nginx includes it in the http context (sites-enabled/ or
# conf.d/).
#
# nginx refuses to load a server block whose certificate files do not exist
# yet, so the file is enabled in two steps:
#
#   1. Before the certificate exists only the port-80 block below is active. It
#      answers the ACME HTTP-01 challenge from a webroot and redirects
#      everything else to HTTPS:
#        sudo mkdir -p /var/www/certbot
#        sudo nginx -t && sudo systemctl reload nginx
#        sudo certbot certonly --webroot -w /var/www/certbot -d wiki.example.com \
#            --agree-tos -m admin@example.com --no-eff-email \
#            --deploy-hook "systemctl reload nginx"
#   2. Uncomment the HTTPS server block at the end of this file, then run
#        sudo nginx -t && sudo systemctl reload nginx
#
# Renewals reuse the webroot and the deploy hook, so keep the port-80 block.
#
# Security headers: dtxWiki sends its own (a per-path CSP for the OAuth consent
# nonce and the loopback form-action, X-Frame-Options, nosniff, Referrer-Policy
# and HSTS). Do not add_header them to proxied locations: nginx would append a
# second copy, and browsers enforce every CSP they receive, which breaks the
# per-path policy. Only the error response nginx generates itself sets them.

# Access log without query strings: legacy password-reset and email
# verification links carried a one-time ?token=, and a log must never keep it.
log_format dtxwiki_no_query '$remote_addr - $remote_user [$time_local] '
                            '"$request_method $uri $server_protocol" '
                            '$status $body_bytes_sent "$http_user_agent"';

server {
    listen 80;
    server_name wiki.example.com;
    access_log /var/log/nginx/dtxwiki.access.log dtxwiki_no_query;

    # ACME HTTP-01 challenge (certbot --webroot -w /var/www/certbot).
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

