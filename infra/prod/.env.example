# dtxWiki production config.
# Copy to /etc/dtxwiki/dtxwiki.env (chmod 640, owned root:dtxwiki), then edit the
# three values under "EDIT THESE". Everything else has a safe default.
#
# Tip: the one-command installer fills these for you —
#   sudo dtxwiki setup production --domain wiki.example.com --email admin@example.com
# This template is the manual / debug path.

# ============================================================
#  EDIT THESE (3)
# ============================================================

# 1. Your public HTTPS domain. Drives OAuth/MCP metadata and, by default, CORS.
DTXWIKI_PUBLIC_BASE_URL=https://wiki.example.com

# 2. Session secret. Required: dtxWiki refuses to start while it is empty.
#    Generate it once and paste the output after the '=':
#      python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DTXWIKI_SESSION_SECRET=

# 3. OAuth JWT signing key. Generate once, then let the service group read it
#    (keygen writes it 0600 for the user who runs it):
#      sudo dtxwiki keygen --output /etc/dtxwiki/jwt.pem
#      sudo chown root:dtxwiki /etc/dtxwiki/jwt.pem && sudo chmod 0640 /etc/dtxwiki/jwt.pem
DTXWIKI_OAUTH_JWT_PRIVATE_KEY_PATH=/etc/dtxwiki/jwt.pem

# ============================================================
#  Defaults — usually leave as-is
# ============================================================
DTXWIKI_APP_ENV=production
DTXWIKI_APP_MODE=team
DTXWIKI_DATABASE_URL=sqlite+pysqlite:////var/lib/dtxwiki/dtxwiki.sqlite
# Writable state root (uploads/library/logs). MUST be inside the systemd unit's
# ReadWritePaths (/var/lib/dtxwiki); the default (~/.dtxwiki) is read-only under
# ProtectSystem=strict, which would 500 every upload. `dtxwiki update`/`rollback`
# also resolve backups under this dir.
DTXWIKI_DATA_DIR=/var/lib/dtxwiki
# The systemd installation starts dtxwiki-worker.service automatically.
DTXWIKI_WORKER_MODE=external
DTXWIKI_MCP_HTTP_MODE=streamable

# Browser session lifetime policy (seconds). Ordinary sessions are absolute
# and non-sliding. Remembered sessions renew through successful /auth/me calls
# only near expiry and never beyond 90 days from the original login.
DTXWIKI_SESSION_TTL_SECONDS=43200
DTXWIKI_SESSION_REMEMBERED_TTL_SECONDS=2592000
DTXWIKI_SESSION_REMEMBERED_REFRESH_THRESHOLD_SECONDS=604800
DTXWIKI_SESSION_REMEMBERED_ABSOLUTE_TTL_SECONDS=7776000

# Team mode disables self-signup by default. Set true only when public
# self-service registration with a private Personal Workspace is intentional.
DTXWIKI_SIGNUP_ENABLED=false

# Account recovery is operator-assisted until SMTP is configured. Recovery
# links are always built from DTXWIKI_PUBLIC_BASE_URL, never the request Host.
DTXWIKI_MAIL_PROVIDER=none
# To enable verified-email recovery, set provider=smtp and configure all fields:
# DTXWIKI_MAIL_FROM_ADDRESS=wiki@example.com
# DTXWIKI_SMTP_HOST=smtp.example.com
# DTXWIKI_SMTP_PORT=587
# DTXWIKI_SMTP_USERNAME=<smtp-username>
# DTXWIKI_SMTP_PASSWORD=<smtp-secret>
# DTXWIKI_SMTP_STARTTLS=true
# DTXWIKI_SMTP_USE_SSL=false
# DTXWIKI_SMTP_TIMEOUT_SECONDS=10

# Run `dtxwiki bootstrap` once, manually, after install. Auto-bootstrap stays off.
DTXWIKI_AUTO_BOOTSTRAP=false

# TLS / certificate handling. Display-only metadata written by
# `dtxwiki setup production` (acme|internal|custom|external|none); the reverse
# proxy actually terminates TLS. See the "Internal network" block below.
DTXWIKI_TLS_MODE=acme

# Reverse proxy in front of the app. List the proxy's IP(s); a Caddy/nginx on the
# same host is 127.0.0.1.
DTXWIKI_BEHIND_PROXY=true
DTXWIKI_FORWARDED_ALLOW_IPS=127.0.0.1

# CORS: defaults to DTXWIKI_PUBLIC_BASE_URL (same-origin) — no need to repeat the
# domain. Set this ONLY if the browser app is served from a different origin
# (comma-separated list, no '*').
# DTXWIKI_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ============================================================
#  Advanced (optional)
# ============================================================

# Metrics endpoint — off by default. To enable, set ENABLED=1 AND a bearer token
# OR an IP allowlist. Generate the token, never reuse an example value:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# DTXWIKI_METRICS_ENABLED=1
# DTXWIKI_METRICS_BEARER_TOKEN=
# DTXWIKI_METRICS_ALLOWLIST=10.0.0.0/8

# Inline JWT PEM (tests only; production uses *_PATH above):
# DTXWIKI_OAUTH_JWT_PRIVATE_KEY_PEM=<inline-pem>

# ---- Internal network / no public domain ----
# When there is no public DNS name (LAN-only), use an internal hostname or IP and
# pick a non-acme TLS mode. Prefer the interactive installer, which also writes
# the matching Caddyfile and prints client root-CA trust steps:
#   sudo dtxwiki setup production --tls internal --domain wiki.lan
# internal  -> Caddy local CA issues for wiki.lan/IP; clients trust the root CA:
#     DTXWIKI_PUBLIC_BASE_URL=https://wiki.lan
#     DTXWIKI_TLS_MODE=internal
# none      -> plain HTTP, EVAL ONLY (auth in plaintext; team OAuth won't work):
#     DTXWIKI_PUBLIC_BASE_URL=http://192.168.1.50
#     DTXWIKI_TLS_MODE=none
#     DTXWIKI_ALLOW_INSECURE_HTTP=true

# External PostgreSQL is not a supported production path yet — see DEVELOPMENT.md.
# DTXWIKI_DATABASE_URL=postgresql+pg8000://dtxwiki:<password>@127.0.0.1:5432/dtxwiki?ssl_context=true

# Optional providers (default: none)
# DTXWIKI_LLM_PROVIDER=none
# DTXWIKI_EMBEDDING_PROVIDER=none

# Updates (`dtxwiki update` / `dtxwiki info` / Setup banner)
# Trusted private package index/proxy that `dtxwiki update` uses instead of the
# default index. It must provide dtxWiki and all dependencies.
# DTXWIKI_UPDATE_INDEX_URL=https://pypi.internal/simple
# Release channel: stable (default) or prerelease.
# DTXWIKI_UPDATE_CHANNEL=stable
# Set to true to silence the "update available" notice (info + Setup banner).
# DTXWIKI_NO_UPDATE_NOTIFIER=false
# How many pre-update backups to retain (default 5).
# DTXWIKI_UPDATE_KEEP_BACKUPS=5
