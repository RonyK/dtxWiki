# infra/prod/Caddyfile.docker.internal
# Internal-CA HTTPS variant of Caddyfile.docker (no public domain / no ACME).
# Caddy issues from its own local CA via `tls internal`. The root CA lives in the
# caddy_data volume (back that volume up too); export it for client trust with:
#   docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt ./dtxwiki-root.crt
# Select this file by setting DTXWIKI_CADDYFILE=./Caddyfile.docker.internal and
# DTXWIKI_TLS_MODE=internal in your .env (no DTXWIKI_ADMIN_EMAIL needed).

{
	local_certs
}

{$DTXWIKI_DOMAIN} {
	tls internal
	encode gzip zstd

	# Transport cap: above the largest application upload policy (50,000,000
	# bytes) plus multipart framing. dtxWiki still enforces its own, lower
	# per-route limits. Same value as client_max_body_size in the nginx example.
	request_body {
		max_size 64MB
	}

	reverse_proxy app:21080 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	# dtxWiki sends these headers itself, including a per-path CSP (OAuth
	# consent nonce, loopback form-action, sandboxed documents) and HSTS.
	# `header ?Name` only fills in a header the response lacks (for example an
	# error Caddy generates while the app restarts), so the app's values always
	# win. Keep one directive per header: Caddy applies the `?` fields of one
	# block only when ALL of them are missing.
	header ?Strict-Transport-Security "max-age=31536000"
	header ?X-Content-Type-Options "nosniff"
	header ?X-Frame-Options "DENY"
	header ?Referrer-Policy "strict-origin-when-cross-origin"
	header ?Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"

	# Access log without credentials: legacy password-reset and email
	# verification links carried a one-time ?token=, and the Referer of a page
	# opened from such a link repeats it.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
					delete access_token
				}
				request>headers>Referer delete
			}
		}
	}
}
