# dtxWiki frontend (Vite) local dev config. Copy to `.env.local`.
# Both are LOCAL DEV only — packaged/production builds ignore these and use the
# backend's same-origin runtime config + the logged-in browser session.

# Backend API the dev server talks to. Matches the backend's DTXWIKI_BACKEND_PORT
# (default 21080). Point it elsewhere to develop against a remote backend.
VITE_API_BASE_URL=http://127.0.0.1:21080

# Optional dev auth: sent as `Authorization: Bearer <token>` so you can call the
# API without OAuth login. Leave blank to use the normal browser session.
# For local dev, set it to the backend's DTXWIKI_DEV_TOKEN (e.g. dev-local).
VITE_DTXWIKI_API_TOKEN=
