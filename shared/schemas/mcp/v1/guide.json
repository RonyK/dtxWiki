{
  "input": {
    "additionalProperties": false,
    "properties": {
      "conversation_token": {
        "anyOf": [
          {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Opaque MCP conversation token. Omit or pass 'new' to start a new dtxWiki MCP chat; echo the returned envelope value to append.",
        "title": "Conversation Token"
      },
      "detail_level": {
        "default": "brief",
        "description": "'brief' (default): what reading, editing and exploring need. 'normal' adds taxonomies, prompt/resource entry points, AgentPage policy, hot concepts and your full tool list. 'detailed' adds the full workspace summary and field explanations. 'full' is the old name of 'detailed'.",
        "enum": [
          "brief",
          "normal",
          "detailed",
          "full"
        ],
        "title": "Detail Level",
        "type": "string"
      },
      "workspace_id": {
        "format": "uuid",
        "title": "Workspace Id",
        "type": "string"
      }
    },
    "required": [
      "workspace_id"
    ],
    "title": "GuideInput",
    "type": "object"
  },
  "output": {
    "$defs": {
      "EnvelopeWarning": {
        "additionalProperties": false,
        "description": "Structured warning attached to MCP/REST envelope responses.\n\nHotfix-2 renamed this model to avoid shadowing Python's builtin warning\nbase class. Wire shape (``code`` + ``message``) is unchanged; only the\nPython class name and JSON Schema title move.",
        "properties": {
          "code": {
            "description": "Stable warning code; must be drawn from WARNING_CODES.",
            "enum": [
              "stale",
              "permission_limited",
              "citation_missing",
              "citation_weak",
              "citation_stale",
              "token_budget",
              "workflow_sequence_incomplete",
              "draft_not_injectable",
              "expired_context",
              "archived",
              "unsupported_retrieval_mode_fallback",
              "deprecated_tool",
              "conversation_token_not_supplied",
              "unresolved_diverged_branch",
              "conversation_read_stale",
              "lint_publish_blocked",
              "published_with_findings",
              "draft_unpublished",
              "text_occurrence_mismatch",
              "text_not_found",
              "unsupported_filter_tag",
              "unsupported_filter_date",
              "semantic_fallback_used",
              "keyword_lane_unavailable",
              "coverage_gap_recorded",
              "evidence_not_citable",
              "mrtr_preview_unavailable",
              "borrowed_rerank_applied",
              "borrowed_query_rewrite_applied",
              "llm_provider_unavailable",
              "llm_composer_failed",
              "job_fanout_incomplete"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "EnvelopeWarning",
        "type": "object"
      },
      "GuidePayload": {
        "additionalProperties": false,
        "description": "The workspace guide at one detail level.\n\nbrief (the default) carries what reading, editing and exploring need;\nnormal and detailed add fields, never unbounded lists.",
        "properties": {
          "actor_context": {
            "additionalProperties": true,
            "title": "Actor Context",
            "type": "object"
          },
          "agent_injection_policy": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Agent Injection Policy"
          },
          "agent_page_taxonomy": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "title": "Agent Page Taxonomy",
            "type": "array"
          },
          "available_prompts": {
            "items": {
              "type": "string"
            },
            "title": "Available Prompts",
            "type": "array"
          },
          "available_resources": {
            "items": {
              "type": "string"
            },
            "title": "Available Resources",
            "type": "array"
          },
          "available_tools": {
            "items": {
              "type": "string"
            },
            "title": "Available Tools",
            "type": "array"
          },
          "citation_policy": {
            "additionalProperties": true,
            "title": "Citation Policy",
            "type": "object"
          },
          "context_page_taxonomy": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "title": "Context Page Taxonomy",
            "type": "array"
          },
          "detail_level": {
            "enum": [
              "brief",
              "normal",
              "detailed"
            ],
            "title": "Detail Level",
            "type": "string"
          },
          "detail_levels": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Detail Levels",
            "type": "object"
          },
          "field_explanations": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Field Explanations",
            "type": "object"
          },
          "hot_concepts": {
            "items": {
              "$ref": "#/$defs/HotConceptEntry"
            },
            "title": "Hot Concepts",
            "type": "array"
          },
          "library_policy_summary": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Library Policy Summary"
          },
          "recommended_agent_guidance_flow": {
            "items": {
              "type": "string"
            },
            "title": "Recommended Agent Guidance Flow",
            "type": "array"
          },
          "required_workflow": {
            "items": {
              "type": "string"
            },
            "title": "Required Workflow",
            "type": "array"
          },
          "workspace_routing": {
            "$ref": "#/$defs/WorkspaceRouting"
          },
          "workspace_summary": {
            "additionalProperties": true,
            "title": "Workspace Summary",
            "type": "object"
          }
        },
        "required": [
          "detail_level",
          "detail_levels",
          "workspace_summary",
          "actor_context",
          "citation_policy",
          "workspace_routing",
          "required_workflow"
        ],
        "title": "GuidePayload",
        "type": "object"
      },
      "HotConceptEntry": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "title",
          "path",
          "score"
        ],
        "title": "HotConceptEntry",
        "type": "object"
      },
      "MCPActor": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "human",
              "mcp_client",
              "agent",
              "system"
            ],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "title": "MCPActor",
        "type": "object"
      },
      "MCPErrorDetail": {
        "additionalProperties": false,
        "description": "One actionable defect in a rejected tool call.\n\nShaped for a caller that has to repair its own request: `field` locates the\nproblem, `message` states it, and `fix` says what to send instead. Never\necho the offending value here \u2014 a rejected `body_markdown` can be a\nmegabyte, and reflecting client input back into a response (and into the\nstored trace) is both wasteful and an injection vector.",
        "properties": {
          "candidates": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/TextMatchCandidate"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Candidates"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Field"
          },
          "fix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fix"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "operation_index": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Operation Index"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "MCPErrorDetail",
        "type": "object"
      },
      "MCPResultEnvelope": {
        "additionalProperties": false,
        "properties": {
          "activity_ref": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Activity Ref"
          },
          "actor": {
            "anyOf": [
              {
                "$ref": "#/$defs/MCPActor"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "actor_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Actor Id"
          },
          "actor_kind": {
            "anyOf": [
              {
                "enum": [
                  "human",
                  "mcp_client",
                  "agent",
                  "system"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Actor Kind"
          },
          "audit_event_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Audit Event Id"
          },
          "client_self_reported": {
            "default": false,
            "title": "Client Self Reported",
            "type": "boolean"
          },
          "conversation_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Opaque MCP conversation token. Echo this value on the next tool call to append to the same dtxWiki MCP chat.",
            "title": "Conversation Token"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error Code"
          },
          "error_details": {
            "items": {
              "$ref": "#/$defs/MCPErrorDetail"
            },
            "title": "Error Details",
            "type": "array"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error Message"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Meta"
          },
          "model_id": {
            "default": "unknown",
            "title": "Model Id",
            "type": "string"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model Version"
          },
          "params_summary": {
            "additionalProperties": true,
            "title": "Params Summary",
            "type": "object"
          },
          "provider": {
            "default": "unknown",
            "title": "Provider",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "result_status": {
            "enum": [
              "accepted",
              "succeeded",
              "failed",
              "partial",
              "rejected_by_policy",
              "needs_review",
              "conflict"
            ],
            "title": "Result Status",
            "type": "string"
          },
          "result_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Result Summary"
          },
          "retryable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Retryable",
            "x-wire-explicit": true
          },
          "review_item_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Review Item Id"
          },
          "schema_version": {
            "const": "llmwiki.mcp.v1",
            "default": "llmwiki.mcp.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "warnings": {
            "items": {
              "$ref": "#/$defs/EnvelopeWarning"
            },
            "title": "Warnings",
            "type": "array"
          },
          "workspace_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Workspace Id"
          }
        },
        "required": [
          "result_status"
        ],
        "title": "MCPResultEnvelope",
        "type": "object"
      },
      "TextMatchCandidate": {
        "additionalProperties": false,
        "description": "Where replace_text's old_text nearly matched, by position only.\n\nEvidence for a refused match, so the caller can re-address one block\ninstead of re-reading the page. It deliberately carries no text: the\ncandidate is page content, and echoing it would put authored text into\nserver guidance and the durable trace.",
        "properties": {
          "block_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Block Id"
          },
          "line_end": {
            "minimum": 1,
            "title": "Line End",
            "type": "integer"
          },
          "line_start": {
            "minimum": 1,
            "title": "Line Start",
            "type": "integer"
          },
          "match_kind": {
            "enum": [
              "exact",
              "normalized",
              "fuzzy"
            ],
            "title": "Match Kind",
            "type": "string"
          },
          "similarity": {
            "maximum": 1,
            "minimum": 0,
            "title": "Similarity",
            "type": "number"
          }
        },
        "required": [
          "line_start",
          "line_end",
          "similarity",
          "match_kind"
        ],
        "title": "TextMatchCandidate",
        "type": "object"
      },
      "WorkspaceRouting": {
        "additionalProperties": false,
        "description": "How to find and read pages here, sized by what the whole workspace\nweighs rather than by how many pages it has.",
        "properties": {
          "bundle_estimated_bytes": {
            "description": "Estimated size of the whole-workspace bundle resource: the stored bodies of the pages you can see.",
            "title": "Bundle Estimated Bytes",
            "type": "integer"
          },
          "bundle_resource": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The bundle resource URI, given only within the budget.",
            "title": "Bundle Resource"
          },
          "guidance": {
            "title": "Guidance",
            "type": "string"
          },
          "visible_pages": {
            "title": "Visible Pages",
            "type": "integer"
          },
          "whole_read": {
            "enum": [
              "within_budget",
              "over_budget"
            ],
            "title": "Whole Read",
            "type": "string"
          },
          "whole_read_budget_bytes": {
            "title": "Whole Read Budget Bytes",
            "type": "integer"
          }
        },
        "required": [
          "visible_pages",
          "bundle_estimated_bytes",
          "whole_read_budget_bytes",
          "whole_read",
          "guidance"
        ],
        "title": "WorkspaceRouting",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "data": {
        "anyOf": [
          {
            "$ref": "#/$defs/GuidePayload"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "envelope": {
        "$ref": "#/$defs/MCPResultEnvelope"
      }
    },
    "required": [
      "envelope"
    ],
    "title": "GuideOutput",
    "type": "object"
  }
}
