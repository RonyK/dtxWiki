{
  "input": {
    "additionalProperties": false,
    "properties": {
      "agent_page_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Agent Page Id"
      },
      "conversation_token": {
        "anyOf": [
          {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Opaque MCP conversation token. Omit or pass 'new' to start a new dtxWiki MCP chat; echo the returned envelope value to append.",
        "title": "Conversation Token"
      },
      "slug": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Slug"
      },
      "version_selector": {
        "default": "active",
        "title": "Version Selector",
        "type": "string"
      },
      "workspace_id": {
        "format": "uuid",
        "title": "Workspace Id",
        "type": "string"
      }
    },
    "required": [
      "workspace_id"
    ],
    "title": "ReadAgentPageInput",
    "type": "object"
  },
  "output": {
    "$defs": {
      "AgentPageDetail": {
        "additionalProperties": false,
        "properties": {
          "body_markdown": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Body Markdown"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "children_count": {
            "default": 0,
            "title": "Children Count",
            "type": "integer"
          },
          "current_active_version_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Current Active Version Id"
          },
          "frontmatter": {
            "additionalProperties": true,
            "title": "Frontmatter",
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "injection_policy": {
            "title": "Injection Policy",
            "type": "string"
          },
          "latest_draft_version_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Latest Draft Version Id"
          },
          "lifecycle_status": {
            "title": "Lifecycle Status",
            "type": "string"
          },
          "metadata_provenance": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Metadata Provenance"
          },
          "parent_node_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Parent Node Id"
          },
          "priority": {
            "title": "Priority",
            "type": "integer"
          },
          "sensitivity": {
            "title": "Sensitivity",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "tree_path": {
            "items": {
              "$ref": "#/$defs/TreePathEntry"
            },
            "title": "Tree Path",
            "type": "array"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version_info": {
            "anyOf": [
              {
                "$ref": "#/$defs/VersionInfo"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "id",
          "category",
          "title",
          "slug",
          "lifecycle_status",
          "injection_policy",
          "priority",
          "sensitivity",
          "updated_at"
        ],
        "title": "AgentPageDetail",
        "type": "object"
      },
      "EnvelopeWarning": {
        "additionalProperties": false,
        "description": "Structured warning attached to MCP/REST envelope responses.\n\nHotfix-2 renamed this model to avoid shadowing Python's builtin warning\nbase class. Wire shape (``code`` + ``message``) is unchanged; only the\nPython class name and JSON Schema title move.",
        "properties": {
          "code": {
            "description": "Stable warning code; must be drawn from WARNING_CODES.",
            "enum": [
              "stale",
              "permission_limited",
              "citation_missing",
              "citation_weak",
              "citation_stale",
              "token_budget",
              "workflow_sequence_incomplete",
              "draft_not_injectable",
              "expired_context",
              "archived",
              "unsupported_retrieval_mode_fallback",
              "deprecated_tool",
              "conversation_token_not_supplied",
              "unresolved_diverged_branch",
              "conversation_read_stale",
              "lint_publish_blocked",
              "published_with_findings",
              "draft_unpublished",
              "text_occurrence_mismatch",
              "text_not_found",
              "unsupported_filter_tag",
              "unsupported_filter_date",
              "disambiguation_required",
              "semantic_fallback_used",
              "keyword_lane_unavailable",
              "coverage_gap_recorded",
              "evidence_not_citable",
              "mrtr_preview_unavailable",
              "borrowed_rerank_applied",
              "borrowed_query_rewrite_applied",
              "llm_provider_unavailable",
              "llm_composer_failed",
              "job_fanout_incomplete",
              "context_page_has_no_graph_visible_links"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "EnvelopeWarning",
        "type": "object"
      },
      "MCPActor": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "human",
              "mcp_client",
              "agent",
              "system"
            ],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "title": "MCPActor",
        "type": "object"
      },
      "MCPErrorDetail": {
        "additionalProperties": false,
        "description": "One actionable defect in a rejected tool call.\n\nShaped for a caller that has to repair its own request: `field` locates the\nproblem, `message` states it, and `fix` says what to send instead. Never\necho the offending value here \u2014 a rejected `body_markdown` can be a\nmegabyte, and reflecting client input back into a response (and into the\nstored trace) is both wasteful and an injection vector.",
        "properties": {
          "candidates": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/TextMatchCandidate"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Candidates"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Field"
          },
          "fix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fix"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "operation_index": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Operation Index"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "MCPErrorDetail",
        "type": "object"
      },
      "MCPResultEnvelope": {
        "additionalProperties": false,
        "properties": {
          "activity_ref": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Activity Ref"
          },
          "actor": {
            "anyOf": [
              {
                "$ref": "#/$defs/MCPActor"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "actor_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Actor Id"
          },
          "actor_kind": {
            "anyOf": [
              {
                "enum": [
                  "human",
                  "mcp_client",
                  "agent",
                  "system"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Actor Kind"
          },
          "audit_event_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Audit Event Id"
          },
          "client_self_reported": {
            "default": false,
            "title": "Client Self Reported",
            "type": "boolean"
          },
          "conversation_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Opaque MCP conversation token. Echo this value on the next tool call to append to the same dtxWiki MCP chat.",
            "title": "Conversation Token"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error Code"
          },
          "error_details": {
            "items": {
              "$ref": "#/$defs/MCPErrorDetail"
            },
            "title": "Error Details",
            "type": "array"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error Message"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Meta"
          },
          "model_id": {
            "default": "unknown",
            "title": "Model Id",
            "type": "string"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model Version"
          },
          "params_summary": {
            "additionalProperties": true,
            "title": "Params Summary",
            "type": "object"
          },
          "provider": {
            "default": "unknown",
            "title": "Provider",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "result_status": {
            "enum": [
              "accepted",
              "succeeded",
              "failed",
              "partial",
              "rejected_by_policy",
              "needs_review",
              "conflict"
            ],
            "title": "Result Status",
            "type": "string"
          },
          "result_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Result Summary"
          },
          "retryable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Retryable"
          },
          "review_item_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Review Item Id"
          },
          "schema_version": {
            "const": "llmwiki.mcp.v1",
            "default": "llmwiki.mcp.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "warnings": {
            "items": {
              "$ref": "#/$defs/EnvelopeWarning"
            },
            "title": "Warnings",
            "type": "array"
          },
          "workspace_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Workspace Id"
          }
        },
        "required": [
          "result_status"
        ],
        "title": "MCPResultEnvelope",
        "type": "object"
      },
      "TextMatchCandidate": {
        "additionalProperties": false,
        "description": "Where replace_text's old_text nearly matched, by position only.\n\nEvidence for a refused match, so the caller can re-address one block\ninstead of re-reading the page. It deliberately carries no text: the\ncandidate is page content, and echoing it would put authored text into\nserver guidance and the durable trace.",
        "properties": {
          "block_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Block Id"
          },
          "line_end": {
            "minimum": 1,
            "title": "Line End",
            "type": "integer"
          },
          "line_start": {
            "minimum": 1,
            "title": "Line Start",
            "type": "integer"
          },
          "match_kind": {
            "enum": [
              "exact",
              "normalized",
              "fuzzy"
            ],
            "title": "Match Kind",
            "type": "string"
          },
          "similarity": {
            "maximum": 1,
            "minimum": 0,
            "title": "Similarity",
            "type": "number"
          }
        },
        "required": [
          "line_start",
          "line_end",
          "similarity",
          "match_kind"
        ],
        "title": "TextMatchCandidate",
        "type": "object"
      },
      "TreePathEntry": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "node_kind": {
            "title": "Node Kind",
            "type": "string"
          },
          "section": {
            "title": "Section",
            "type": "string"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Slug"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "section",
          "title",
          "node_kind"
        ],
        "title": "TreePathEntry",
        "type": "object"
      },
      "VersionInfo": {
        "additionalProperties": false,
        "properties": {
          "content_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Content Hash"
          },
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Created At"
          },
          "graph_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Graph Status"
          },
          "history_status": {
            "anyOf": [
              {
                "enum": [
                  "state_inconsistent",
                  "current_editing",
                  "current_draft",
                  "published_snapshot",
                  "alternative_draft",
                  "discarded_draft",
                  "superseded_snapshot",
                  "superseded_draft"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "History Status"
          },
          "is_alternative": {
            "default": false,
            "title": "Is Alternative",
            "type": "boolean"
          },
          "is_discarded": {
            "default": false,
            "title": "Is Discarded",
            "type": "boolean"
          },
          "is_draft_head": {
            "default": false,
            "title": "Is Draft Head",
            "type": "boolean"
          },
          "is_published_head": {
            "default": false,
            "title": "Is Published Head",
            "type": "boolean"
          },
          "is_visible_head": {
            "default": false,
            "title": "Is Visible Head",
            "type": "boolean"
          },
          "parent_version_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Parent Version Id"
          },
          "review_disposition": {
            "default": "none",
            "enum": [
              "rejected",
              "pending",
              "approved",
              "none"
            ],
            "title": "Review Disposition",
            "type": "string"
          },
          "version_id": {
            "format": "uuid",
            "title": "Version Id",
            "type": "string"
          },
          "version_no": {
            "title": "Version No",
            "type": "integer"
          },
          "version_status": {
            "title": "Version Status",
            "type": "string"
          }
        },
        "required": [
          "version_id",
          "version_no",
          "version_status"
        ],
        "title": "VersionInfo",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "data": {
        "anyOf": [
          {
            "$ref": "#/$defs/AgentPageDetail"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "envelope": {
        "$ref": "#/$defs/MCPResultEnvelope"
      }
    },
    "required": [
      "envelope"
    ],
    "title": "ReadAgentPageOutput",
    "type": "object"
  }
}
