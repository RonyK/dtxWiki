{
  "input": {
    "additionalProperties": false,
    "properties": {
      "aliases": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "maxItems": 32,
        "title": "Aliases",
        "x-normalized-item-maxLength": 80,
        "x-normalized-item-minLength": 1
      },
      "body_md": {
        "default": "",
        "description": "The final stored Markdown, including managed frontmatter, must contain at most 1000000 Unicode code points.",
        "maxLength": 1000000,
        "title": "Body Md",
        "type": "string",
        "x-final-maxLength": 1000000
      },
      "conversation_token": {
        "anyOf": [
          {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Opaque MCP conversation token. Omit or pass 'new' to start a new dtxWiki MCP chat; echo the returned envelope value to append.",
        "title": "Conversation Token"
      },
      "page_type": {
        "anyOf": [
          {
            "enum": [
              "overview",
              "source",
              "entity",
              "concept",
              "synthesis",
              "comparison",
              "decision",
              "contradiction",
              "query",
              "guide"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Page Type"
      },
      "placement_parent_node_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Placement Parent Node Id"
      },
      "tags": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "maxItems": 32,
        "title": "Tags",
        "x-normalized-item-maxLength": 48,
        "x-normalized-item-minLength": 1
      },
      "title": {
        "anyOf": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Maximum 256 Unicode code points after approved edge-space normalization. Explicit input is never truncated.",
        "title": "Title",
        "x-normalized-maxLength": 256
      },
      "workspace_id": {
        "format": "uuid",
        "title": "Workspace Id",
        "type": "string"
      }
    },
    "required": [
      "workspace_id"
    ],
    "title": "CreateContextPageInput",
    "type": "object"
  },
  "output": {
    "$defs": {
      "ContextEditResult": {
        "additionalProperties": false,
        "description": "What an edit command saved: the version to address next and what changed.\n\nThe body is not repeated. edit_receipt.changes quotes the replaced\nregions; when you need text the receipt does not show, read this version\nby version_id (target.version_id), which still names it after a submit.",
        "properties": {
          "change_set_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Change Set Id"
          },
          "content_hash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Content Hash",
            "type": "string"
          },
          "edit_receipt": {
            "anyOf": [
              {
                "$ref": "#/$defs/EditReceipt"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "What this write changed: sections, line/char counts, the replaced regions, per-operation positions, and (for a patch) the id and hash of every block whose id or hash changed. replace_block keeps the block's id; a block other edits changed keeps its id while its text stays close to the old text, otherwise it gets a new one. An idempotent replay returns the receipt of the call it replays, which may describe an earlier revision. null on submit."
          },
          "editing_revision": {
            "title": "Editing Revision",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "lint_report": {
            "additionalProperties": true,
            "description": "Save-time fixes and findings for the final stored body.",
            "title": "Lint Report",
            "type": "object"
          },
          "publish_blocked_reasons": {
            "items": {
              "$ref": "#/$defs/DraftReviewReason"
            },
            "title": "Publish Blocked Reasons",
            "type": "array"
          },
          "review_item_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Review Item Id"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "version_id": {
            "format": "uuid",
            "title": "Version Id",
            "type": "string"
          },
          "version_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Version Status"
          }
        },
        "required": [
          "id",
          "version_id",
          "editing_revision",
          "content_hash",
          "title",
          "slug"
        ],
        "title": "ContextEditResult",
        "type": "object"
      },
      "DraftReviewReason": {
        "additionalProperties": false,
        "description": "One reason a write did not simply publish.\n\nLives here rather than beside either write surface because both use it: the\nMCP result names why a draft went to review, and the REST page payload names\nwhy a save was held from publication.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "DraftReviewReason",
        "type": "object"
      },
      "EditReceipt": {
        "additionalProperties": false,
        "description": "Positions and sizes of one edit: sections, lines, characters, blocks.",
        "properties": {
          "body_adjusted": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Whether the stored body differs from the body your request produced: managed frontmatter was added or synced, or a format fix ran. null when unknown.",
            "title": "Body Adjusted",
            "x-wire-explicit": true
          },
          "changed_blocks": {
            "description": "Blocks whose id or hash is new after a patch, so a follow-up block-addressed patch needs no read_structure_map round trip. Unchanged blocks keep the id and hash you already hold. Listed up to 50; changed_blocks_omitted_count counts the rest.",
            "items": {
              "$ref": "#/$defs/EditReceiptBlock"
            },
            "title": "Changed Blocks",
            "type": "array"
          },
          "changed_blocks_omitted_count": {
            "default": 0,
            "title": "Changed Blocks Omitted Count",
            "type": "integer"
          },
          "changed_sections": {
            "description": "Heading paths of the sections the edit touched (max 20).",
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Changed Sections",
            "type": "array"
          },
          "changes": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/EditReceiptChange"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The regions this patch or whole-body update replaced, in document order: exactly what the stored body now says, including any server fix. Listed until 20 regions or 4 KB; changes_omitted_count counts the rest. null on create and when unknown (a replay of a receipt stored before this field).",
            "title": "Changes",
            "x-wire-explicit": true
          },
          "changes_omitted_count": {
            "default": 0,
            "title": "Changes Omitted Count",
            "type": "integer"
          },
          "chars_added": {
            "default": 0,
            "title": "Chars Added",
            "type": "integer"
          },
          "chars_removed": {
            "default": 0,
            "title": "Chars Removed",
            "type": "integer"
          },
          "edit_mode": {
            "enum": [
              "patch",
              "whole_body",
              "create"
            ],
            "title": "Edit Mode",
            "type": "string"
          },
          "editing_revision_after": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Editing Revision After"
          },
          "editing_revision_before": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Editing Revision Before"
          },
          "lines_added": {
            "default": 0,
            "title": "Lines Added",
            "type": "integer"
          },
          "lines_removed": {
            "default": 0,
            "title": "Lines Removed",
            "type": "integer"
          },
          "operations": {
            "items": {
              "$ref": "#/$defs/EditReceiptOperation"
            },
            "title": "Operations",
            "type": "array"
          },
          "server_fixes": {
            "description": "Format fixes the server applied while saving, by label.",
            "items": {
              "type": "string"
            },
            "title": "Server Fixes",
            "type": "array"
          }
        },
        "required": [
          "edit_mode"
        ],
        "title": "EditReceipt",
        "type": "object"
      },
      "EditReceiptBlock": {
        "additionalProperties": false,
        "properties": {
          "hash": {
            "title": "Hash",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "hash"
        ],
        "title": "EditReceiptBlock",
        "type": "object"
      },
      "EditReceiptChange": {
        "additionalProperties": false,
        "description": "One replaced region of the body, as exact text.\n\nremoved is the text the edit replaced and added the text now in its place.\nBetween two edits on one line the region also carries the unchanged text\nthat separates them. Region and context text is untrusted user-authored\ncontent.",
        "properties": {
          "added": {
            "title": "Added",
            "type": "string"
          },
          "context_after": {
            "description": "Up to 40 unchanged characters after the region, same line.",
            "title": "Context After",
            "type": "string"
          },
          "context_before": {
            "description": "Up to 40 unchanged characters before the region, same line.",
            "title": "Context Before",
            "type": "string"
          },
          "line": {
            "description": "1-indexed line in the new body where the region starts.",
            "title": "Line",
            "type": "integer"
          },
          "removed": {
            "title": "Removed",
            "type": "string"
          }
        },
        "required": [
          "line",
          "context_before",
          "removed",
          "added",
          "context_after"
        ],
        "title": "EditReceiptChange",
        "type": "object"
      },
      "EditReceiptOperation": {
        "additionalProperties": false,
        "properties": {
          "affected_block_ids": {
            "items": {
              "type": "string"
            },
            "title": "Affected Block Ids",
            "type": "array"
          },
          "chars_added": {
            "default": 0,
            "title": "Chars Added",
            "type": "integer"
          },
          "chars_removed": {
            "default": 0,
            "title": "Chars Removed",
            "type": "integer"
          },
          "heading_path": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Heading Path"
          },
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "line_range": {
            "anyOf": [
              {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "1-indexed inclusive line range in the body BEFORE the patch.",
            "title": "Line Range"
          },
          "match_kind": {
            "anyOf": [
              {
                "enum": [
                  "exact",
                  "normalized",
                  "fuzzy"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "replace_text only: how old_text was found. 'normalized' ignored whitespace/Unicode differences; 'fuzzy' forgave a small copy slip inside the addressed block or section -- check the result.",
            "title": "Match Kind"
          },
          "match_policy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "replace_text only: version of the matching rules applied.",
            "title": "Match Policy"
          },
          "match_similarity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only for match_kind='fuzzy': 0-1 similarity of the target.",
            "title": "Match Similarity"
          },
          "matched_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only for a non-exact match: sha256 of the original text that was replaced (several matches joined by NUL).",
            "title": "Matched Sha256"
          },
          "op": {
            "title": "Op",
            "type": "string"
          }
        },
        "required": [
          "index",
          "op"
        ],
        "title": "EditReceiptOperation",
        "type": "object"
      },
      "EnvelopeWarning": {
        "additionalProperties": false,
        "description": "Structured warning attached to MCP/REST envelope responses.\n\nHotfix-2 renamed this model to avoid shadowing Python's builtin warning\nbase class. Wire shape (``code`` + ``message``) is unchanged; only the\nPython class name and JSON Schema title move.",
        "properties": {
          "code": {
            "description": "Stable warning code; must be drawn from WARNING_CODES.",
            "enum": [
              "stale",
              "permission_limited",
              "citation_missing",
              "citation_weak",
              "citation_stale",
              "token_budget",
              "workflow_sequence_incomplete",
              "draft_not_injectable",
              "expired_context",
              "archived",
              "unsupported_retrieval_mode_fallback",
              "deprecated_tool",
              "conversation_token_not_supplied",
              "unresolved_diverged_branch",
              "conversation_read_stale",
              "lint_publish_blocked",
              "published_with_findings",
              "draft_unpublished",
              "text_occurrence_mismatch",
              "text_not_found",
              "unsupported_filter_tag",
              "unsupported_filter_date",
              "semantic_fallback_used",
              "keyword_lane_unavailable",
              "coverage_gap_recorded",
              "evidence_not_citable",
              "mrtr_preview_unavailable",
              "borrowed_rerank_applied",
              "borrowed_query_rewrite_applied",
              "llm_provider_unavailable",
              "llm_composer_failed",
              "job_fanout_incomplete",
              "context_page_has_no_graph_visible_links"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "EnvelopeWarning",
        "type": "object"
      },
      "MCPActor": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "human",
              "mcp_client",
              "agent",
              "system"
            ],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "title": "MCPActor",
        "type": "object"
      },
      "MCPErrorDetail": {
        "additionalProperties": false,
        "description": "One actionable defect in a rejected tool call.\n\nShaped for a caller that has to repair its own request: `field` locates the\nproblem, `message` states it, and `fix` says what to send instead. Never\necho the offending value here \u2014 a rejected `body_markdown` can be a\nmegabyte, and reflecting client input back into a response (and into the\nstored trace) is both wasteful and an injection vector.",
        "properties": {
          "candidates": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/TextMatchCandidate"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Candidates"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Field"
          },
          "fix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fix"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "operation_index": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Operation Index"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "MCPErrorDetail",
        "type": "object"
      },
      "MCPResultEnvelope": {
        "additionalProperties": false,
        "properties": {
          "activity_ref": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Activity Ref"
          },
          "actor": {
            "anyOf": [
              {
                "$ref": "#/$defs/MCPActor"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "actor_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Actor Id"
          },
          "actor_kind": {
            "anyOf": [
              {
                "enum": [
                  "human",
                  "mcp_client",
                  "agent",
                  "system"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Actor Kind"
          },
          "audit_event_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Audit Event Id"
          },
          "client_self_reported": {
            "default": false,
            "title": "Client Self Reported",
            "type": "boolean"
          },
          "conversation_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Opaque MCP conversation token. Echo this value on the next tool call to append to the same dtxWiki MCP chat.",
            "title": "Conversation Token"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error Code"
          },
          "error_details": {
            "items": {
              "$ref": "#/$defs/MCPErrorDetail"
            },
            "title": "Error Details",
            "type": "array"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error Message"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Meta"
          },
          "model_id": {
            "default": "unknown",
            "title": "Model Id",
            "type": "string"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model Version"
          },
          "params_summary": {
            "additionalProperties": true,
            "title": "Params Summary",
            "type": "object"
          },
          "provider": {
            "default": "unknown",
            "title": "Provider",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "result_status": {
            "enum": [
              "accepted",
              "succeeded",
              "failed",
              "partial",
              "rejected_by_policy",
              "needs_review",
              "conflict"
            ],
            "title": "Result Status",
            "type": "string"
          },
          "result_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Result Summary"
          },
          "retryable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Retryable",
            "x-wire-explicit": true
          },
          "review_item_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Review Item Id"
          },
          "schema_version": {
            "const": "llmwiki.mcp.v1",
            "default": "llmwiki.mcp.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "warnings": {
            "items": {
              "$ref": "#/$defs/EnvelopeWarning"
            },
            "title": "Warnings",
            "type": "array"
          },
          "workspace_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Workspace Id"
          }
        },
        "required": [
          "result_status"
        ],
        "title": "MCPResultEnvelope",
        "type": "object"
      },
      "TextMatchCandidate": {
        "additionalProperties": false,
