{
  "input": {
    "additionalProperties": false,
    "properties": {
      "body": {
        "maxLength": 10000,
        "minLength": 1,
        "title": "Body",
        "type": "string"
      },
      "conversation_token": {
        "anyOf": [
          {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Opaque MCP conversation token. Omit or pass 'new' to start a new dtxWiki MCP chat; echo the returned envelope value to append.",
        "title": "Conversation Token"
      },
      "severity": {
        "default": "minor",
        "enum": [
          "info",
          "minor",
          "major",
          "critical"
        ],
        "title": "Severity",
        "type": "string"
      },
      "suggested_action": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "maxLength": 2000,
        "title": "Suggested Action"
      },
      "target_id": {
        "description": "Context page UUID or stable_url: /p/<workspace_id>/<page_id> or /p/<page_id> in this workspace.",
        "maxLength": 512,
        "minLength": 1,
        "pattern": "^(?:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|/p/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?:/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?(?:#[^\\s]*)?)$",
        "title": "Target Id",
        "type": "string"
      },
      "target_type": {
        "enum": [
          "agent_page",
          "context_page",
          "section",
          "context_claim",
          "context_citation",
          "answer",
          "source",
          "library_artifact"
        ],
        "title": "Target Type",
        "type": "string"
      },
      "workspace_id": {
        "format": "uuid",
        "title": "Workspace Id",
        "type": "string"
      }
    },
    "required": [
      "target_type",
      "target_id",
      "body",
      "workspace_id"
    ],
    "title": "SubmitFeedbackInput",
    "type": "object"
  },
  "output": {
    "$defs": {
      "EnvelopeWarning": {
        "additionalProperties": false,
        "description": "Structured warning attached to MCP/REST envelope responses.\n\nHotfix-2 renamed this model to avoid shadowing Python's builtin warning\nbase class. Wire shape (``code`` + ``message``) is unchanged; only the\nPython class name and JSON Schema title move.",
        "properties": {
          "code": {
            "description": "Stable warning code; must be drawn from WARNING_CODES.",
            "enum": [
              "stale",
              "permission_limited",
              "citation_missing",
              "citation_weak",
              "citation_stale",
              "token_budget",
              "workflow_sequence_incomplete",
              "draft_not_injectable",
              "expired_context",
              "archived",
              "unsupported_retrieval_mode_fallback",
              "deprecated_tool",
              "conversation_token_not_supplied",
              "unresolved_diverged_branch",
              "conversation_read_stale",
              "lint_publish_blocked",
              "published_with_findings",
              "draft_unpublished",
              "text_occurrence_mismatch",
              "text_not_found",
              "unsupported_filter_tag",
              "unsupported_filter_date",
              "semantic_fallback_used",
              "keyword_lane_unavailable",
              "coverage_gap_recorded",
              "evidence_not_citable",
              "mrtr_preview_unavailable",
              "borrowed_rerank_applied",
              "borrowed_query_rewrite_applied",
              "llm_provider_unavailable",
              "llm_composer_failed",
              "job_fanout_incomplete"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "EnvelopeWarning",
        "type": "object"
      },
      "MCPActor": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "human",
              "mcp_client",
              "agent",
              "system"
            ],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "title": "MCPActor",
        "type": "object"
      },
      "MCPErrorDetail": {
        "additionalProperties": false,
        "description": "One actionable defect in a rejected tool call.\n\nShaped for a caller that has to repair its own request: `field` locates the\nproblem, `message` states it, and `fix` says what to send instead. Never\necho the offending value here \u2014 a rejected `body_markdown` can be a\nmegabyte, and reflecting client input back into a response (and into the\nstored trace) is both wasteful and an injection vector.",
        "properties": {
          "candidates": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/TextMatchCandidate"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Candidates"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Field"
          },
          "fix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fix"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "operation_index": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Operation Index"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "MCPErrorDetail",
        "type": "object"
      },
      "MCPResultEnvelope": {
        "additionalProperties": false,
        "properties": {
          "activity_ref": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Activity Ref"
          },
          "actor": {
            "anyOf": [
              {
                "$ref": "#/$defs/MCPActor"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "actor_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Actor Id"
          },
          "actor_kind": {
            "anyOf": [
              {
                "enum": [
                  "human",
                  "mcp_client",
                  "agent",
                  "system"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Actor Kind"
          },
          "audit_event_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Audit Event Id"
          },
          "client_self_reported": {
            "default": false,
            "title": "Client Self Reported",
            "type": "boolean"
          },
          "conversation_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Opaque MCP conversation token. Echo this value on the next tool call to append to the same dtxWiki MCP chat.",
            "title": "Conversation Token"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error Code"
          },
          "error_details": {
            "items": {
              "$ref": "#/$defs/MCPErrorDetail"
            },
            "title": "Error Details",
            "type": "array"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error Message"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Meta"
          },
          "model_id": {
            "default": "unknown",
            "title": "Model Id",
            "type": "string"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model Version"
          },
          "params_summary": {
            "additionalProperties": true,
            "title": "Params Summary",
            "type": "object"
          },
          "provider": {
            "default": "unknown",
            "title": "Provider",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "result_status": {
            "enum": [
              "accepted",
              "succeeded",
              "failed",
              "partial",
              "rejected_by_policy",
              "needs_review",
              "conflict"
            ],
            "title": "Result Status",
            "type": "string"
          },
          "result_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Result Summary"
          },
          "retryable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Retryable",
            "x-wire-explicit": true
          },
          "review_item_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Review Item Id"
          },
          "schema_version": {
            "const": "llmwiki.mcp.v1",
            "default": "llmwiki.mcp.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "warnings": {
            "items": {
              "$ref": "#/$defs/EnvelopeWarning"
            },
            "title": "Warnings",
            "type": "array"
          },
          "workspace_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Workspace Id"
          }
        },
        "required": [
          "result_status"
        ],
        "title": "MCPResultEnvelope",
        "type": "object"
      },
      "SubmitFeedbackResult": {
        "additionalProperties": false,
        "properties": {
          "feedback_id": {
            "format": "uuid",
            "title": "Feedback Id",
            "type": "string"
          },
          "next_action": {
            "enum": [
              "agent_resolution_queued",
              "needs_user_review",
              "none"
            ],
            "title": "Next Action",
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "triaged"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "feedback_id",
          "status",
          "next_action"
        ],
        "title": "SubmitFeedbackResult",
        "type": "object"
      },
      "TextMatchCandidate": {
        "additionalProperties": false,
        "description": "Where replace_text's old_text nearly matched, by position only.\n\nEvidence for a refused match, so the caller can re-address one block\ninstead of re-reading the page. It deliberately carries no text: the\ncandidate is page content, and echoing it would put authored text into\nserver guidance and the durable trace.",
        "properties": {
          "block_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Block Id"
          },
          "line_end": {
            "minimum": 1,
            "title": "Line End",
            "type": "integer"
          },
          "line_start": {
            "minimum": 1,
            "title": "Line Start",
            "type": "integer"
          },
          "match_kind": {
            "enum": [
              "exact",
              "normalized",
              "fuzzy"
            ],
            "title": "Match Kind",
            "type": "string"
          },
          "similarity": {
            "maximum": 1,
            "minimum": 0,
            "title": "Similarity",
            "type": "number"
          }
        },
        "required": [
          "line_start",
          "line_end",
          "similarity",
          "match_kind"
        ],
        "title": "TextMatchCandidate",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "data": {
        "anyOf": [
          {
            "$ref": "#/$defs/SubmitFeedbackResult"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "envelope": {
        "$ref": "#/$defs/MCPResultEnvelope"
      }
    },
    "required": [
      "envelope"
    ],
    "title": "SubmitFeedbackToolOutput",
    "type": "object"
  }
}
