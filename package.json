{
  "name": "dtxwiki-monorepo",
  "private": true,
  "license": "AGPL-3.0-only OR Elastic-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "frontend",
    "desktop"
  ],
  "scripts": {
    "check:i18n": "node scripts/check-i18n-coverage.mjs",
    "desktop:test": "npm --workspace desktop test",
    "desktop:pack": "npm --workspace desktop run pack",
    "desktop:win": "npm --workspace desktop run build:win",
    "desktop:mac": "npm --workspace desktop run build:mac",
    "lint:md": "markdownlint-cli2",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "playwright:install": "playwright install chromium firefox webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@redocly/openapi-core": "^1.34.7",
    "markdownlint-cli2": "^0.23.1"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
